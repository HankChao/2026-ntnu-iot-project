# Database Configuration
POSTGRES_DB=maps6
POSTGRES_USER=maps6
POSTGRES_PASSWORD=maps6_secret
DATABASE_URL=postgres://maps6:maps6_secret@postgres:5432/maps6

# MQTT Configuration (see docs/MQTT.md)
# Run scripts/setup.sh (Windows: scripts\setup.ps1) to fill in MQTT_PASSWORD.
# ESP32 and MAPS boxes must use the same MQTT_USERNAME / MQTT_PASSWORD.
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=clothes
MQTT_PASSWORD=
MQTT_PORT=1883
MQTT_TLS_PORT=8883
# 0.0.0.0 = plain MQTT reachable from the LAN (needed by the ESP32); 127.0.0.1 = TLS only
MQTT_PLAIN_BIND=0.0.0.0
# Clips need no setting here: each publishes on clothes/<its id>/raw and appears on its first report.
# Only for a clip still on firmware before 0.5.0 (one shared topic): CLOTHES_MQTT_TOPIC=clothes/raw
# Air box paired with the clothes dashboard/CSV; empty = the one that reported most recently
CLOTHES_AIRBOX_ID=
# LAN hostname or IPv4 address clips use to download OTA images; do not expose this HTTP port publicly.
FIRMWARE_HTTP_HOST=
FIRMWARE_HTTP_PORT=8088

# App Configuration
PORT=3000
# Admin login must use a password hash or a mounted Apache htpasswd file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_HTPASSWD_FILE=
ADMIN_PASSWORD_UPGRADE_FILE=
AUTH_COOKIE_SECURE=true

# Web / Nginx Configuration
WEB_PORT=8088
APP_PORT=3000
POSTGRES_PORT=5432

CWA_API_KEY=
CWA_STATION=臺北
