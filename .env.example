# Database Configuration
POSTGRES_DB=maps6
POSTGRES_USER=maps6
POSTGRES_PASSWORD=maps6_secret
DATABASE_URL=postgres://maps6:maps6_secret@postgres:5432/maps6

# MQTT Configuration (see docs/MQTT.md)
# Run scripts/setup.sh (Windows: scripts\setup.ps1) to fill in MQTT_PASSWORD.
# ESP32 and MAPS boxes must use the same MQTT_USERNAME / MQTT_PASSWORD.
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=clothes
MQTT_PASSWORD=
MQTT_PORT=1883
MQTT_TLS_PORT=8883
# 0.0.0.0 = plain MQTT reachable from the LAN (needed by the ESP32); 127.0.0.1 = TLS only
MQTT_PLAIN_BIND=0.0.0.0
CLOTHES_MQTT_TOPIC=clothes/raw

# App Configuration
PORT=3000
SESSION_SECRET=maps6_super_secret_session_key

# Web / Nginx Configuration
WEB_PORT=8088
APP_PORT=3000
POSTGRES_PORT=5432
